# Priva — client config
# Everything here ships to the browser inside the JS bundle, so treat it as
# public. The TMDB v3 key is a read-only metadata key: restrict it to your
# domain(s) in your TMDB account settings if you care.
VITE_TMDB_API_KEY=a45420333457411e78d5ad35d6c51a2d

# Optional: a TMDB v4 read access token instead of the v3 key. If set it is
# sent as an Authorization header (avoids the api_key query param).
VITE_TMDB_TOKEN=

# Optional: OMDb api key, used only to pull the IMDb rating *number*.
# Without it Priva shows the IMDb link plus the TMDB score. https://www.omdbapi.com/apikey.aspx
VITE_OMDB_KEY=
